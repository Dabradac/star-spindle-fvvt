<table class="spindle-table skills-table">
  <thead>
    <tr>
      <th colspan="2" {{#if @root.abilityTiers}}rowspan="2"{{/if}}>{{localize "SPINDLE.Attributes"}}</th>
      <th colspan="2" {{#if @root.abilityTiers}}rowspan="2"{{/if}}>{{localize "SPINDLE.Skills"}}</th>
      <th data-tooltip="SPINDLE.TotalTooltip" {{#if @root.abilityTiers}}rowspan="2"{{/if}}>{{localize "SPINDLE.Total"}}</th>
      {{#if @root.abilityTiers}}<th colspan="{{@root.abilityTiers.length}}">{{localize "SPINDLE.Abilities"}}</th>{{/if}}
    </tr>
    {{#if @root.abilityTiers}}
    <tr class="tier-row">
      {{#each @root.abilityTiers as |t|}}<th class="tier-head">{{t}}</th>{{/each}}
    </tr>
    {{/if}}
  </thead>
  <tbody>
    {{#each attributeRows as |attr|}}
    {{#each attr.skills as |skill|}}
    <tr class="{{#if @first}}attr-start{{/if}}">
      {{#if @first}}
      <th class="attribute" rowspan="{{attr.skills.length}}">
        <a data-action="rollAttribute" data-attribute="{{attr.key}}" data-tooltip="SPINDLE.RollTooltip">{{localize attr.label}}</a>
      </th>
      <td class="attribute-value" rowspan="{{attr.skills.length}}">
        <input type="number" name="system.attributes.{{attr.key}}.value" value="{{attr.value}}" min="0">
        {{#unless (eq attr.value attr.effective)}}<small class="effective" data-tooltip="SPINDLE.EffectiveTooltip">{{attr.effective}}</small>{{/unless}}
      </td>
      {{/if}}
      <td class="skill-name {{#if skill.professional}}professional{{/if}} {{#if skill.untrained}}untrained{{/if}}">
        <a data-action="rollSkill" data-skill="{{skill.key}}" data-tooltip="{{#if skill.professional}}SPINDLE.ProfessionalSkill{{else}}SPINDLE.RollTooltip{{/if}}">{{localize skill.label}}</a>
      </td>
      <td class="skill-value">
        <input type="number" name="system.skills.{{skill.key}}.value" value="{{skill.value}}" min="0">
      </td>
      <td class="skill-total">
        <a data-action="rollSkill" data-skill="{{skill.key}}">{{skill.total}}{{#if skill.bonus}}<small>{{numberFormat skill.bonus sign=true}}</small>{{/if}} <i class="fa-solid fa-dice-d20"></i></a>
      </td>
      {{#each skill.tiers as |cell|}}
      <td class="ability-cell">
        {{#each cell.items as |item|}}
        <div class="ability-chip item draggable {{#if item.system.used}}used{{/if}}" draggable="true" data-item-id="{{item.id}}">
          <a class="ability-name" data-action="itemEdit" data-tooltip="{{item.name}}">{{item.name}}</a>
          {{#if item.system.active}}<a class="ability-use" data-action="itemUse" data-tooltip="SPINDLE.Ability.Use"><i class="fa-solid fa-bolt"></i></a>{{/if}}
          {{#if @root.editable}}<a class="ability-delete" data-action="itemDelete" data-tooltip="SPINDLE.Delete"><i class="fa-solid fa-xmark"></i></a>{{/if}}
        </div>
        {{else}}
        {{#if @root.editable}}<a class="ability-add" data-action="itemCreate" data-type="ability" data-system-skill="{{skill.key}}" data-system-tier="{{cell.tier}}" data-tooltip="SPINDLE.Create"><i class="fa-solid fa-plus"></i></a>{{/if}}
        {{/each}}
      </td>
      {{/each}}
    </tr>
    {{/each}}
    {{/each}}
  </tbody>
</table>
