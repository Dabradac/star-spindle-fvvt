<section class="effects">
  <header class="section-header">
    <h3>{{localize "SPINDLE.Effect.Plural"}}</h3>
    {{#if @root.editable}}<a class="create" data-action="effectCreate" data-tooltip="SPINDLE.Create"><i class="fa-solid fa-plus"></i></a>{{/if}}
  </header>
  <ol class="item-list simple-list">
    {{#each effects as |effect|}}
    <li class="item draggable {{#if effect.disabled}}disabled{{/if}}" draggable="true" data-effect-id="{{effect.id}}">
      <img class="item-img" src="{{effect.img}}" alt="">
      <span class="item-name" data-action="effectEdit">{{effect.name}}</span>
      {{#if @root.editable}}
      <div class="item-controls">
        <a data-action="effectToggle" data-tooltip="SPINDLE.Effect.Toggle"><i class="fa-solid {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></a>
        <a data-action="effectEdit" data-tooltip="SPINDLE.Edit"><i class="fa-solid fa-pen-to-square"></i></a>
        <a data-action="effectDelete" data-tooltip="SPINDLE.Delete"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{/if}}
    </li>
    {{else}}
    <li class="empty">{{localize "SPINDLE.Empty"}}</li>
    {{/each}}
  </ol>
</section>
